[4126.339697, "o", "\u001b[?25l\u001b[2;33r\u001b[2;1H\u001b[3L\u001b[1;34r\u001b[1;1H{% for router in routers %}\r\nhostname {{ router.hostname }}\u001b[34;91H\u001b[K\u001b[34;91H4,1\u001b[11CAll\u001b[4;1H\u001b[?25h"]
[4126.35022, "o", "\u001b[?25l\u001b[5;33r\u001b[5;1H\u001b[19L\u001b[1;34r\u001b[4;1H{% for interface in router.interfaces %}\r\ninterface {{ interface.name }}\r\n description {{ interface.description }}\r\n{% if interface.name != 'l0' %}\r\n no shutdown\r\n{% endif %}\r\n{% if interface.ip %}\r\n ip address {{ interface.ip }} {{ interface.subnet }}\r\n{% endif %}\r\n{% endfor %}\r\n\r\nrouter ospf 1\r\n router-id {{ router.ospf.router_id }}\r\n{% for net in router.ospf.networks %}\r\n network {{ net.ip }} {{ net.wildcard }} area {{ net.area }}\r\n{% endfor %}\r\n\r\n!\r\n{% endfor %}\u001b[34;91H\u001b[K\u001b[34;91H23,1\u001b[10CAll\u001b[23;1H\u001b[?25h"]
