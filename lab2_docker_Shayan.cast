[5362.481695, "o", "    --recurse-submodules[=<pathspec>]\r\n                          initialize submodules in the clone\r\n    -j, --jobs <n>"]
[5362.481991, "o", "        number of submodules cloned in parallel\r\n    --template <template-directory>\r\n                          directory from which templates will be used\r\n"]
[5362.483556, "o", "    --reference <repo>    reference repository\r\n    --reference-if-able <repo>\r\n"]
[5362.483866, "o", "                          reference repository\r\n    --dissociate          use --reference only while cloning\r\n    -o"]
[5362.484181, "o", ", --origin <name>   use <name> instead of 'origin' to track upstream\r\n    -b, --branch <branch>"]
[5362.484511, "o", "\r\n                          checkout <branch> instead of the remote's HEAD\r\n    -u, --upload-pack <path>\r\n                          path to git-upload-pack on the remote"]
[5362.4849, "o", "\r\n    --depth <depth>       create a shallow clone of that depth\r\n    --shallow-since <time>\r\n"]
[5362.485415, "o", "                          create a shallow clone since a specific time\r\n    --shallow-exclude <revision>\r\n                          deepen history of shallow clone, excluding rev\r\n    --single-branch       clone only one branch, HEAD or --branch\r\n    --no-tags             don't clone any tags, and make later fetches not to follow them\r\n    --shallow-submodules  any cloned submodules will be shallow\r\n    --separate-git-dir <gitdir>\r\n"]
[5362.485862, "o", "                          separate git dir from working tree\r\n    -c, --config <key=value>\r\n                          set config inside the new repository\r\n    --server-option <server-specific>"]
[5362.486373, "o", "\r\n                          option to transmit\r\n    -4, --ipv4            use IPv4 addresses only\r\n    -6, --ipv6            use IPv6 addresses only\r\n    --filter <args>"]
