[8712.627319, "o", "\r\n"]
[8712.656481, "o", "\u001b[36mdb_1   |\u001b[0m The files belonging to this database system will be owned by user \"postgres\"."]
[8712.657286, "o", "\r\n\u001b[36mdb_1   |\u001b[0m This user must also own the server process."]
[8712.657615, "o", "\r\n\u001b[36mdb_1   |\u001b[0m "]
[8712.658195, "o", "\r\n"]
[8712.658587, "o", "\u001b[36mdb_1   |\u001b[0m The database cluster will be initialized with locale \"en_US.utf8\".\r\n\u001b[36mdb_1   |\u001b[0m The default database encoding has accordingly been set to \"UTF8\"."]
