[5299.209507, "o", "\u001b[?2004h\u001b]0;root@1ad56abc2470: /\u0007root@1ad56abc2470:/# \u001b[K"]
[5312.199553, "o", "\u001b[7mgit clone --single-branch --branch dist-amd64\u001b[27m\r\n\r\u001b[7mhttps://github.com/tianon/docker-brew-ubuntu-core.git\u001b[27m"]
[5312.811885, "o", "\u001b[A\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\bgit clone --single-branch --branch dist-amd64\r\n\rhttps://github.com/tianon/docker-brew-ubuntu-core.git\r\n\u001b[?2004l\r"]
[5312.813163, "o", "fatal: You must specify a repository to clone."]
[5312.813982, "o", "\r\n"]
[5312.814783, "o", "\r\n"]
[5312.815646, "o", "usage: git clone [<options>] [--] <repo> [<dir>]"]
[5312.816428, "o", "\r\n"]
[5312.817189, "o", "\r\n"]
[5312.818052, "o", "    "]
[5312.819948, "o", "-v, --[no-]verbose    be more verbose\r\n    -q, --[no-]quiet      be more quiet\r\n    --[no-]progress       force progress reporting\r\n    --[no-]reject-shallow don't clone shallow repository\r\n    -n, --no-checkout     don't create a checkout\r\n    --checkout            opposite of --no-checkout\r\n    --[no-]bare           "]
[5312.822512, "o", "create a bare repository\r\n    --[no-]mirror         create a mirror repository (implies bare)\r\n    -l, --[no-]local      to clone from a local repository\r\n    --no-hardlinks        don't use local hardlinks, always copy\r\n    --hardlinks           opposite of --no-hardlinks\r\n    -s, --[no-]shared     setup as shared repository\r\n    --[no-]recurse-submodules[=<pathspec>]\r\n                          initialize submodules in the clone\r\n    --[no-]recursive ...  alias of --recurse-submodules\r\n    -j, --[no-]jobs <n>   number of submodules cloned in parallel\r\n    --[no-]template <template-directory>\r\n                          directory from which templates will be used\r\n    --[no-]reference <repo>\r\n                          reference repository\r\n    --[no-]reference-if-able <repo>\r\n                          reference repository\r\n    --[no-]dissociate     use --reference only while cloning\r\n    -o, --[no-]origin"]
[5312.82457, "o", " <name>\r\n                          use <name> instead of 'origin' to track upstream\r\n    -b, --[no-]branch <branch>\r\n                          checkout <branch> instead of the remote's HEAD\r\n    -u, --[no-]upload-pack <path>\r\n                          path to git-upload-pack on the remote\r\n    --[no-]depth <depth>  create a shallow clone of that depth\r\n    --[no-]shallow-since <time>\r\n                          create a shallow clone since a specific time"]
[5312.826197, "o", "\r\n    --[no-]shallow-exclude <revision>\r\n                          deepen history of shallow clone, excluding rev\r\n    --[no-]single-branch  clone only one branch, HEAD or --branch\r\n    --no-tags             don't clone any tags, and make later fetches not to follow them\r\n    --tags                opposite of --no-tags\r\n    --[no-]shallow-submodules\r\n                          any cloned submodules will be shallow\r\n    --[no-]separate-git-dir <gitdir>\r\n                          separate git dir from working tree\r\n    -c, --[no-]config <key=value>\r\n                          set config inside the new repository\r\n    --[no-]server-option <server-specific>\r\n                          option to transmit\r\n    -4, --ipv4            use IPv4 addresses only\r\n    -6, --ipv6            use IPv6 addresses only\r\n    --[no-]filter <args>  object filtering\r\n    --[no-]also-filter-submodules\r\n                          apply partial clone filters to submodules\r\n    --[no-]remote-submodules\r\n                          any cloned "]
[5312.826591, "o", "submodules will use their remote-tracking branch\r\n    --[no-]sparse         initialize sparse-checkout file to include only files at root\r\n    --[no-]bundle-uri <uri>\r\n                          a URI for downloading bundles before fetching from origin remote\r\n\r\n"]
[5312.829534, "o", "bash: https://github.com/tianon/docker-brew-ubuntu-core.git: No such file or directory\r\n\u001b[?2004h"]
