[4230.096072, "o", "\r\n"]
[4230.096425, "o", "    "]
[4230.096819, "o", "--bare"]
[4230.097081, "o", "                create a bare repository"]
[4230.097345, "o", "\r\n"]
[4230.097613, "o", "    "]
[4230.097848, "o", "--mirror"]
[4230.098113, "o", "              create a mirror repository (implies bare)"]
[4230.098886, "o", "\r\n"]
[4230.099151, "o", "    "]
[4230.099392, "o", "-l"]
[4230.099668, "o", ", "]
[4230.099898, "o", "--local"]
[4230.100135, "o", "           to clone from a local repository"]
[4230.100394, "o", "\r\n"]
[4230.100746, "o", "    --no-hardlinks        don't use local hardlinks, always copy\r\n    -s"]
[4230.101103, "o", ", --shared          setup as shared repository\r\n    --recursive ...       alias of --recurse-submodules\r\n    "]
[4230.101471, "o", "--recurse-submodules[=<pathspec>]\r\n                          initialize submodules in the clone\r\n    -j, --jobs <n>"]
[4230.101882, "o", "        number of submodules cloned in parallel\r\n    --template <template-directory>\r\n                          directory from which templates will be used\r\n    --reference <repo>    reference repository"]
[4230.103173, "o", "\r\n    --reference-if-able <repo>\r\n                          reference repository\r\n    --dissociate          use --reference only while cloning\r\n    -o, --origin <name>   use <name> instead of 'origin' to track upstream\r\n    -b, --branch <branch>\r\n                          checkout <branch> instead of the remote's HEAD\r\n    -u, --upload-pack <path>\r\n"]
[4230.103567, "o", "                          path to git-upload-pack on the remote\r\n    --depth <depth>       create a shallow clone of that depth\r\n    --shallow-since <time>\r\n                          create a shallow clone since a specific time\r\n    --shallow-exclude <revision>\r\n"]
[4230.104001, "o", "                          deepen history of shallow clone, excluding rev\r\n    --single-branch       clone only one branch, HEAD or --branch\r\n    --no-tags             don't clone any tags, and make later fetches not to follow them\r\n    --shallow-submodules  any cloned submodules will be shallow\r\n    --separate-git-dir <gitdir>\r\n"]
[4230.104474, "o", "                          separate git dir from working tree\r\n    -c, --config <key=value>\r\n                          set config inside the new repository\r\n    --server-option <server-specific>\r\n                          option to transmit\r\n    "]
[4230.104903, "o", "-4, --ipv4            use IPv4 addresses only\r\n    -6, --ipv6            use IPv6 addresses only\r\n    --filter <args>       object filtering\r\n    "]
[4230.106173, "o", "--remote-submodules   any cloned submodules will use their remote-tracking branch\r\n    --sparse              initialize sparse-checkout file to include only files at root\r\n\r\n\u001b]0;student@6312vm-csr25: /\u0007student@6312vm-csr25:/$ https://github.com/tianon/docker-brew-ubuntu-core.git"]
