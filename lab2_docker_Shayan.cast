[4745.610883, "o", "------------------"]
[4745.611421, "o", "\r\n"]
[4745.612005, "o", "\r\n"]
[4745.612527, "o", "Please select the geographic area in which you live. Subsequent configuration questions will"]
[4745.613099, "o", "\r\n"]
[4745.613615, "o", "narrow this down by presenting a list of cities, representing the time zones in which they are"]
[4745.614149, "o", "\r\n"]
[4745.614661, "o", "located."]
[4745.615211, "o", "\r\n"]
[4745.615929, "o", "\r\n"]
[4745.619309, "o", "  1. Africa   3. Antarctica  5. Asia      7. Australia  9. Indian    11. Etc\r\n  2. America  4. Arctic      6. Atlantic  8. Europe     10. Pacific  12. Legacy\r\nGeographic area: "]
[4766.402073, "o", "2"]
[4780.477847, "o", "\r\n\r\n"]
[4780.482844, "o", "Please select the city or region corresponding to your time zone."]
