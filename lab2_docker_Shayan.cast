[4230.085022, "o", "fatal: You must specify a repository to clone."]
[4230.085906, "o", "\r\n"]
[4230.086336, "o", "\r\n"]
[4230.086785, "o", "usage: git clone [<options>] [--] <repo> [<dir>]"]
[4230.087168, "o", "\r\n"]
[4230.087626, "o", "\r\n"]
[4230.08801, "o", "    "]
[4230.088404, "o", "-v"]
[4230.088775, "o", ", "]
[4230.08916, "o", "--verbose"]
[4230.08958, "o", "         be more verbose"]
[4230.089986, "o", "\r\n"]
[4230.090359, "o", "    "]
[4230.09076, "o", "-q"]
[4230.091166, "o", ", "]
[4230.09159, "o", "--quiet"]
[4230.091985, "o", "           be more quiet"]
[4230.092374, "o", "\r\n"]
[4230.092743, "o", "    "]
[4230.093155, "o", "--progress"]
[4230.093533, "o", "            force progress reporting"]
[4230.093912, "o", "\r\n"]
[4230.09427, "o", "    "]
[4230.094622, "o", "-n"]
[4230.09496, "o", ", "]
[4230.095313, "o", "--no-checkout"]
