[671.317268, "o", "\u001b[?25l\u001b[35mimport\u001b[m requests\r\n\u001b[35mfrom\u001b[m requests.auth \u001b[35mimport\u001b[m HTTPBasicAuth\u001b[3;40H\u001b[K\u001b[4;1H\u001b[35mimport\u001b[m json\u001b[4;12H\u001b[K\u001b[5;1Hlogging.basicConfig(level=logging.INFO, \u001b[36mformat\u001b[m=\u001b[31m'%(name)s - %(levelname)s - %(message)s'\u001b[m)\u001b[5;89H\u001b[K\u001b[6;1HHOST = \u001b[31m'192.168.1.101'\u001b[m\u001b[6;23H\u001b[K\u001b[7;1HUSER = \u001b[31m'student'\u001b[m\u001b[7;17H\u001b[K\u001b[8;1HPASS = \u001b[31m'Meilab123'\u001b[m\u001b[8;19H\u001b[K\u001b[9;1HBASE_URL = \u001b[31m'http://{0}/restconf/api/running/'\u001b[m.format(HOST)\u001b[9;59H\u001b[K\u001b[10;1H\u001b[33mdef\u001b[m \u001b[36mget_interfaces\u001b[m(append_url):\u001b[10;32H\u001b[K\u001b[11;1H    url = BASE_URL + append_url\u001b[11;32H\u001b[K\u001b[12;1H    auth = HTTPBasicAuth(USER, PASS)\u001b[12;37H\u001b[K\u001b[13;1H    headers = {\u001b[31m'Accept'\u001b[m: \u001b[31m'application/vnd.yang.data+json'\u001b[m}\u001b[13;59H\u001b[K\u001b[14;1H    logging.info(f\u001b[31m\"URL ==> {url}\"\u001b[m)\u001b[14;35H\u001b[K\u001b[15;1H    response = requests.get(url, auth=auth, headers=headers)\u001b[15;61H\u001b[K\u001b[16;1H    \u001b[33mif\u001b[m response.status_code == \u001b[31m200\u001b[m:\u001b[16;36H\u001b[K\u001b[17;1H        logging.info(f\u001b[31m\"Request was successful on {HOST}, Code: {response.status_code"]
[671.318144, "o", "}\"\u001b[m)\u001b[17;88H\u001b[K\u001b[18;1H        \u001b[33mreturn\u001b[m json.dumps(response.json(), sort_keys=\u001b[36mTrue\u001b[m, indent=\u001b[31m4\u001b[m )\u001b[18;70H\u001b[K\u001b[19;1H    \u001b[33melse\u001b[m:\u001b[19;10H\u001b[K\u001b[20;1H        logging.error(f\u001b[31m\"Error encountered during request on {HOST}, Code: {response.status_code}\"\u001b[m)\u001b[20;99H\u001b[K\u001b[21;1H        \u001b[33mreturn\u001b[m response.text\u001b[21;29H\u001b[K\u001b[22;1H    \u001b[36mprint\u001b[m(get_interfaces(\u001b[31m'interfaces'\u001b[m))\u001b[22;40H\u001b[K\u001b[22;10H\u001b[46m(\u001b[28C)\u001b[m\u001b[35;92H2,40\u001b[22;40H\u001b[?25h"]
