[1778.622235, "o", "\u001b[?25l\u001b[107C  \u001b[2;1H                }\u001b[2;18H\u001b[K\u001b[3;1H                                            }\u001b[3;46H\u001b[K\u001b[4;1H\u001b[K\u001b[5;1H                            response = requests.put(\u001b[5;53H\u001b[K\u001b[6;1H                                            url,\u001b[6;49H\u001b[K\u001b[7;1H                                                    headers=headers,\u001b[7;69H\u001b[K\u001b[8;1H                                                            auth=HTTPBasicAuth(username, password),\u001b[8;100H\u001b[K\u001b[9;1H                                                                    json=payload,\u001b[9;82H\u001b[K\u001b[10;1H                                                                            verify=\u001b[36mFalse\u001b[m\u001b[10;89H\u001b[K\u001b[11;1H                                                                                )\u001b[11;82H\u001b[K\u001b[12;1H\u001b[K\u001b[13;1H                                \u001b[33mif\u001b[m response.status_code \u001b[33min\u001b[m [\u001b[31m200\u001b[m, \u001b[31m201\u001b[m, \u001b[31m204\u001b[m]:\u001b[13;76H\u001b[K\u001b[14;1H                                            \u001b[36mprint\u001b[m(f\u001b[31m\"[SUCCESS] {router_ip} - {interface_name} configure"]
[1778.623255, "o", "d.\"\u001b[m)\u001b[14;107H\u001b[K\u001b[15;1H                                                \u001b[33melse\u001b[m:\u001b[15;54H\u001b[K\u001b[16;1H                                                            \u001b[36mprint\u001b[m(f\u001b[31m\"[ERROR] {router_ip} - {interface_name}:  \u001b[17;1H{response.status_code} - {response.text}\"\u001b[m)\u001b[17;43H\u001b[K\u001b[18;1H\u001b[K\u001b[19;1H                                                            \u001b[34m# Map router names to their management IPs\u001b[m\u001b[19;103H\u001b[K\u001b[20;1H                                                            management_ips = {\u001b[20;79H\u001b[K\u001b[21;1H                                                                        \u001b[31m\"R2\"\u001b[m: \u001b[31m\"10.0.20.2\"\u001b[m,\u001b[21;91H\u001b[K\u001b[22;1H                                                                            \u001b[31m\"R3\"\u001b[m: \u001b[31m\"10.0.30.2\"\u001b[m\u001b[22;94H\u001b[K\u001b[23;1H                                                                            }\u001b[23;78H\u001b[K\u001b[24;1H\u001b[K\u001b[25;1H                                                            "]
[1778.626974, "o", "\u001b[34m# Only configure R2 and R3\u001b[m\u001b[25;87H\u001b[K\u001b[26;1H                                                            \u001b[33mfor\u001b[m router \u001b[33min\u001b[m [\u001b[31m\"R2\"\u001b[m, \u001b[31m\"R3\"\u001b[m]:\u001b[26;88H\u001b[K\u001b[27;1H                                                                    interfaces = config[\u001b[31m\"routers\"\u001b[m][router][\u001b[31m\"\"\u001b[28;1Hinterfaces\"\u001b[m]\u001b[28;13H\u001b[K\u001b[29;1H                                                                        mgmt_ip = management_ips[router]\u001b[29;105H\u001b[K\u001b[30;1H                                                                            \u001b[33mfor\u001b[m iface, ip \u001b[33min\u001b[m interfaces.itemm\u001b[31;1Hs():\u001b[31;5H\u001b[K\u001b[32;1H                                                                                        configure_interface((\u001b[33;1Hmgmt_ip, iface, ip)\u001b[33;20H\u001b[K\u001b[34;1H                                                                                        \u001b[34;89H\u001b[K\u001b[35;91H67,89\u001b[9CBot\u001b[34;89H\u001b[?25h"]
