[3193.333541, "o", "\u001b[?25l\u001b[35mimport\u001b[m yaml\r\n\u001b[35mfrom\u001b[m jinja2 \u001b[35mimport\u001b[m Environment, FileSystemLoader\u001b[2;49H\u001b[K\u001b[3;1H\u001b[35mfrom\u001b[m netmiko \u001b[35mimport\u001b[m Netmiko\u001b[3;28H\u001b[K\u001b[35;91H3,28\u001b[3;28H\u001b[?25h"]
[3195.114746, "o", "\u001b[?25l\u001b[4;1H\u001b[K\u001b[35;91H4,1 \u001b[4;1H\u001b[?25h"]
[3206.199185, "o", "\u001b[?25lhosts = yaml.load(\u001b[36mopen\u001b[m(\u001b[31m'hosts.yml'\u001b[m), Loader=yaml.SafeLoader)\r\ninterfaces = yaml.load(\u001b[36mopen\u001b[m(\u001b[31m'interfaces.yml'\u001b[m), Loader=yaml.SafeLoader)\u001b[5;71H\u001b[K\u001b[6;1Henv = Environment(loader = FileSystemLoader(\u001b[31m'.'\u001b[m), trim_blocks=\u001b[36mTrue\u001b[m,\u001b[6;68H\u001b[K\u001b[7;1H        autoescape=\u001b[36mTrue\u001b[m)\u001b[7;25H\u001b[K\u001b[8;1Htemplate = env.get_template(\u001b[31m'interfaces_config_template.j2'\u001b[m)\u001b[8;61H\u001b[K\u001b[9;1Hloopback_config = template.render(data=interfaces)\u001b[9;51H\u001b[K\u001b[10;1H\u001b[33mfor\u001b[m host \u001b[33min\u001b[m hosts[\u001b[31m\"hosts\"\u001b[m]:\u001b[10;28H\u001b[K\u001b[11;1H    net_connect = Netmiko(host = host[\u001b[31m\"name\"\u001b[m],\u001b[11;47H\u001b[K\u001b[12;1H            username = host[\u001b[31m\"username\"\u001b[m],\u001b[12;41H\u001b[K\u001b[13;1H            password = host[\u001b[31m\"password\"\u001b[m],\u001b[13;41H\u001b[K\u001b[14;1H            port = host[\u001b[31m\"port\"\u001b[m],\u001b[14;33H\u001b[K\u001b[15;1H            device_type = host[\u001b[31m\"type\"\u001b[m])\u001b[15;40H\u001b[K\u001b[16;1H    \u001b[36mprint\u001b[m(f\u001b[31m\"Logged into {host['name']} successfully\"\u001b[m)\u001b[16;54H\u001b[K\u001b[17;1H    output = net_connect.send_config_set(loopback_config."]
[3206.200094, "o", "split(\u001b[31m\"\u001b[m\u001b[35m\\n\u001b[m\u001b[31m\"\u001b[m))\u001b[17;70H\u001b[K\u001b[18;1H    \u001b[36mprint\u001b[m(f\u001b[31m\"Pushed config into {host['name']} successfully\"\u001b[m)\u001b[18;61H\u001b[K\u001b[19;1H    net_connect.disconnect()\u001b[19;29H\u001b[K\u001b[20;1H    \u001b[36mprint\u001b[m(\u001b[31m\"Done!\"\u001b[m)\u001b[20;19H\u001b[K\u001b[20;10H\u001b[46m(\u001b[7C)\u001b[m\u001b[35;91H20,19\u001b[20;19H\u001b[?25h"]
