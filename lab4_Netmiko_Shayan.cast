[1836.565065, "o", "\u001b[?25l\u001b[35mfrom\u001b[m netmiko \u001b[35mimport\u001b[m ConnectHandler\r\nr1 = {\u001b[31m\"device_type\"\u001b[m: \u001b[31m\"cisco_ios\"\u001b[m,\u001b[2;34H\u001b[K\u001b[3;1H        \u001b[31m\"ip\"\u001b[m: \u001b[31m\"192.168.1.101\"\u001b[m,\u001b[3;31H\u001b[K\u001b[4;1H        \u001b[31m\"username\"\u001b[m: \u001b[31m\"student\"\u001b[m,\u001b[4;31H\u001b[K\u001b[5;1H        \u001b[31m\"password\"\u001b[m: \u001b[31m\"Meilab123\"\u001b[m,\u001b[5;33H\u001b[K\u001b[6;1H        \u001b[31m\"port\"\u001b[m: \u001b[31m\"22\"\u001b[m}\u001b[6;22H\u001b[K\u001b[7;1Hr2 = {\u001b[31m\"device_type\"\u001b[m: \u001b[31m\"cisco_ios\"\u001b[m,\u001b[7;34H\u001b[K\u001b[8;1H        \u001b[31m\"ip\"\u001b[m: \u001b[31m\"192.168.1.101\"\u001b[m,\u001b[8;31H\u001b[K\u001b[9;1H        \u001b[31m\"username\"\u001b[m: \u001b[31m\"student\"\u001b[m,\u001b[9;31H\u001b[K\u001b[10;1H        \u001b[31m\"password\"\u001b[m: \u001b[31m\"Meilab123\"\u001b[m,\u001b[10;33H\u001b[K\u001b[11;1H        \u001b[31m\"port\"\u001b[m: \u001b[31m\"22\"\u001b[m}\u001b[11;22H\u001b[K\u001b[12;1H\u001b[33mfor\u001b[m device \u001b[33min\u001b[m (r1, r2):\u001b[12;24H\u001b[K\u001b[13;1H    net_connect = ConnectHandler(**device)\u001b[13;43H\u001b[K\u001b[14;1H    output = net_connect.send_command(\u001b[31m\"show interface description\"\u001b[m)\u001b[14;68H\u001b[K\u001b[15;1H    net_connect.disconnect()\u001b[15;29H\u001b[K\u001b[16;1H    \u001b[36mprint\u001b[m(\u001b[31m\"-\"\u001b[m*\u001b[31m100\u001b[m)\u001b[16;19H\u001b[K\u001b[17;1H    \u001b[36mprint\u001b[m(output)\u001b[17;18H"]
[1836.565894, "o", "\u001b[K\u001b[18;1H    \u001b[36mprint\u001b[m(\u001b[31m\"-\"\u001b[m*\u001b[31m100\u001b[m)\u001b[18;19H\u001b[K\u001b[18;10H\u001b[46m(\u001b[7C)\u001b[m\u001b[35;91H18,19\u001b[18;19H\u001b[?25h"]
