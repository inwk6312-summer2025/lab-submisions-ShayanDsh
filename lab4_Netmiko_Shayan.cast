[1861.014202, "o", "\u001b[1;1H\u001b[35mfrom\u001b[m netmiko \u001b[35mimport\u001b[m ConnectHandler\r\nr1 = {\u001b[31m\"device_type\"\u001b[m: \u001b[31m\"cisco_ios\"\u001b[m,\u001b[3;9H\u001b[31m\"ip\"\u001b[m: \u001b[31m\"192.168.1.101\"\u001b[m,\u001b[4;9H\u001b[31m\"username\"\u001b[m: \u001b[31m\"student\"\u001b[m,\u001b[5;9H\u001b[31m\"password\"\u001b[m: \u001b[31m\"Meilab123\"\u001b[m,\u001b[6;9H\u001b[31m\"port\"\u001b[m: \u001b[31m\"22\"\u001b[m}\r\nr2 = {\u001b[31m\"device_type\"\u001b[m: \u001b[31m\"cisco_ios\"\u001b[m,\u001b[8;9H\u001b[31m\"ip\"\u001b[m: \u001b[31m\"192.168.1.101\"\u001b[m,\u001b[9;9H\u001b[31m\"username\"\u001b[m: \u001b[31m\"student\"\u001b[m,\u001b[10;9H\u001b[31m\"password\"\u001b[m: \u001b[31m\"Meilab123\"\u001b[m,\u001b[11;9H\u001b[31m\"port\"\u001b[m: \u001b[31m\"22\"\u001b[m}\r\n\u001b[33mfor\u001b[m device \u001b[33min\u001b[m (r1, r2):\r\n    net_connect = ConnectHandler(**device)\r\n    output = net_connect.send_command(\u001b[31m\"show interface description\"\u001b[m)\r\n    net_connect.disconnect()\r\n    \u001b[36mprint\u001b[m(\u001b[31m\"-\"\u001b[m*\u001b[31m100\u001b[m)\r\n    \u001b[36mprint\u001b[m\u001b[46m(\u001b[moutput\u001b[46m)\u001b[m\r\n    \u001b[36mprint\u001b[m(\u001b[31m\"-\"\u001b[m*\u001b[31m100\u001b[m)\r\n\u001b[1m\u001b[34m~                                                                                                           \u001b[20;1H~                                                                            "]
