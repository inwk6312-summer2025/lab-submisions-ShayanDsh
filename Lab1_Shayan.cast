[5533.825203, "o", "\u001b[?25l\u001b[33mclass\u001b[m \u001b[36mError\u001b[m(\u001b[32mException\u001b[m):\r\n    \u001b[31m\"\"\"Base class for other exceptions\"\"\"\u001b[m\u001b[3;42H\u001b[K\u001b[4;1H    \u001b[33mpass\u001b[m\u001b[4;9H\u001b[K\u001b[5;1H\u001b[33mclass\u001b[m \u001b[36mValueTooSmallError\u001b[m(Error):\u001b[5;33H\u001b[K\u001b[6;1H    \u001b[31m\"\"\"Raised when the input value is too small\"\"\"\u001b[m\u001b[6;51H\u001b[K\u001b[7;1H    \u001b[33mpass\u001b[m\u001b[7;9H\u001b[K\u001b[8;1H\u001b[33mclass\u001b[m \u001b[36mValueTooLargeError\u001b[m(Error):\u001b[8;33H\u001b[K\u001b[9;1H    \u001b[31m\"\"\"Raised when the input value is too large\"\"\"\u001b[m\u001b[9;51H\u001b[K\u001b[10;1H    \u001b[33mpass\u001b[m\u001b[10;9H\u001b[K\u001b[11;1H\u001b[34m# Start of Program\u001b[m\u001b[11;19H\u001b[K\u001b[12;1H\u001b[34m# you need to guess this number\u001b[m\u001b[12;32H\u001b[K\u001b[13;1Hnumber = \u001b[31m10\u001b[m\u001b[13;12H\u001b[K\u001b[14;1H\u001b[34m# user guesses a number until he/she gets it right\u001b[m\u001b[14;51H\u001b[K\u001b[15;1H\u001b[33mwhile\u001b[m \u001b[36mTrue\u001b[m:\u001b[15;12H\u001b[K\u001b[16;1H    \u001b[33mtry\u001b[m:\u001b[16;9H\u001b[K\u001b[17;1H        guess = \u001b[36mint\u001b[m(\u001b[36minput\u001b[m(\u001b[31m\"Enter a number: \"\u001b[m))\u001b[17;47H\u001b[K\u001b[18;1H        \u001b[33mif\u001b[m guess == number:\u001b[18;28H\u001b[K\u001b[19;1H            \u001b[33mbreak\u001b[m\u001b[19;18H\u001b[K\u001b[20;1H        \u001b[33melif\u001b[m guess < number:\u001b[20;29H\u001b[K\u001b[21;1H  "]
[5533.826099, "o", "          \u001b[33mraise\u001b[m ValueTooSmallError\u001b[21;37H\u001b[K\u001b[22;1H        \u001b[33melif\u001b[m guess > number:\u001b[22;29H\u001b[K\u001b[23;1H            \u001b[33mraise\u001b[m ValueTooLargeError\u001b[23;37H\u001b[K\u001b[24;1H        \u001b[33mexcept\u001b[m ValueTooSmallError:\u001b[24;35H\u001b[K\u001b[25;1H            \u001b[36mprint\u001b[m(\u001b[31m\"This value is too small, try again!\"\u001b[m)\u001b[25;57H\u001b[K\u001b[26;1H            \u001b[36mprint\u001b[m()\u001b[26;20H\u001b[K\u001b[27;1H        \u001b[33mexcept\u001b[m ValueTooLargeError:\u001b[27;35H\u001b[K\u001b[28;1H            \u001b[36mprint\u001b[m(\u001b[31m\"This value is too large, try again!\"\u001b[m)\u001b[28;57H\u001b[K\u001b[29;1H            \u001b[36mprint\u001b[m()\u001b[29;20H\u001b[K\u001b[30;1H            \u001b[36mprint\u001b[m(\u001b[31m\"Congratulations! You guessed it correctly.\"\u001b[m)\u001b[30;64H\u001b[K\u001b[30;18H\u001b[46m(\u001b[44C)\u001b[m\u001b[35;91H30,64\u001b[30;64H\u001b[?25h"]
