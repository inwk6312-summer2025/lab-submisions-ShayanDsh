[1531.68225, "o", "\u001b[?25l\u001b[35mimport\u001b[m logging\r\n\u001b[34m# Create a custom logger\u001b[m\u001b[2;25H\u001b[K\u001b[3;1Hlogger = logging.getLogger(__name__)\u001b[3;37H\u001b[K\u001b[4;1H\u001b[34m# Create handlers\u001b[m\u001b[4;18H\u001b[K\u001b[5;1Hc_handler = logging.StreamHandler()\u001b[5;36H\u001b[K\u001b[6;1Hf_handler = logging.FileHandler(\u001b[31m'file.log'\u001b[m)\u001b[6;44H\u001b[K\u001b[7;1Hc_handler.setLevel(logging.WARNING)\u001b[7;36H\u001b[K\u001b[8;1Hf_handler.setLevel(logging.ERROR)\u001b[8;34H\u001b[K\u001b[9;1H\u001b[34m# Create formatters and add it to handlers\u001b[m\u001b[9;43H\u001b[K\u001b[10;1Hc_format = logging.Formatter(\u001b[31m'%(name)s - %(levelname)s - %(message)s'\u001b[m)\u001b[10;71H\u001b[K\u001b[11;1Hf_format = logging.Formatter(\u001b[31m'%(asctime)s - %(name)s - %(levelname)s -\u001b[m\u001b[11;71H\u001b[K\u001b[12;1H\u001b[31m        %(message)s'\u001b[m)\u001b[12;22H\u001b[K\u001b[13;1Hc_handler.setFormatter(c_format)\u001b[13;33H\u001b[K\u001b[14;1Hf_handler.setFormatter(f_format)\u001b[14;33H\u001b[K\u001b[15;1H\u001b[34m# Add handlers to the logger\u001b[m\u001b[15;29H\u001b[K\u001b[16;1Hlogger.addHandler(c_handler)\u001b[16;29H\u001b[K\u001b[17;1Hlogger.addHandler(f_handler)\u001b[17;29H\u001b[K\u001b[18;1Hlogger.warning(\u001b[31m'This is a warning'\u001b[m)\u001b[18;36H\u001b[K\u001b[19;1Hlogger.error(\u001b[31m'Thi"]
