[5644.942827, "o", "\u001b[?25l\u001b[31m\"\"\"Exception raised for errors in the input salary.\r\n    Attributes:\u001b[m\u001b[3;16H\u001b[K\u001b[4;1H\u001b[31m    salary -- input salary which caused the error\u001b[m\u001b[4;50H\u001b[K\u001b[5;1H\u001b[31m    message -- explanation of the error\u001b[m\u001b[5;40H\u001b[K\u001b[6;1H\u001b[31m    \"\"\"\u001b[m\u001b[6;8H\u001b[K\u001b[7;1H    \u001b[33mdef\u001b[m \u001b[36m__init__\u001b[m(self, salary, message=\u001b[31m\"Salary is not in (5000, 15000) range\"\u001b[m):\u001b[7;80H\u001b[K\u001b[8;1H        self.salary = salary\u001b[8;29H\u001b[K\u001b[9;1H        self.message = message\u001b[9;31H\u001b[K\u001b[10;1H        \u001b[36msuper\u001b[m().__init__(self.message)\u001b[10;39H\u001b[K\u001b[11;1H        \u001b[34m# Start of Program\u001b[m\u001b[11;27H\u001b[K\u001b[12;1H        salary = \u001b[36mint\u001b[m(\u001b[36minput\u001b[m(\u001b[31m\"Enter salary amount: \"\u001b[m))\u001b[12;53H\u001b[K\u001b[13;1H        \u001b[33mif\u001b[m \u001b[33mnot\u001b[m \u001b[31m5000\u001b[m < salary < \u001b[31m15000\u001b[m:\u001b[13;38H\u001b[K\u001b[14;1H            \u001b[33mraise\u001b[m SalaryNotInRangeError(salary)\u001b[14;48H\u001b[K\u001b[14;40H\u001b[46m(\u001b[msalary\u001b[46m)\u001b[m\u001b[35;91H14,48\u001b[14;48H\u001b[?25h"]
