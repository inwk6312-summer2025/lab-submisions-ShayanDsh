[3129.865531, "o", "\u001b[1;1H\u001b[35mimport\u001b[m logging\r\n\u001b[34m# Create a custom logger\u001b[m\r\nlogger = logging.getLogger(__name__)\r\n\u001b[34m# Create handlers\u001b[m\r\nc_handler = logging.StreamHandler()\r\nf_handler = logging.FileHandler(\u001b[31m'file.log'\u001b[m)\r\nc_handler.setLevel(logging.WARNING)\r\nf_handler.setLevel(logging.ERROR)\r\n\u001b[34m# Create formatters and add it to handlers\u001b[m\r\nc_format = logging.Formatter(\u001b[31m'%(name)s - %(levelname)s - %(message)s'\u001b[m)\r\nf_format = logging.Formatter(\u001b[31m'%(asctime)s - %(name)s - %(levelname)s -\r\n%(message)s'\u001b[m)\r\nc_handler.setFormatter(c_format)\r\nf_handler.setFormatter(f_format)\r\n\u001b[34m# Add handlers to the logger\u001b[m\r\nlogger.addHandler(c_handler)\r\nlogger.addHandler(f_handler)\r\nlogger.warning(\u001b[31m'This is a warning'\u001b[m)\r\nlogger.error(\u001b[31m'This is an error'\u001b[m)\r\n\u001b[1m\u001b[34m~                                                                                                           \u001b[21;1H~                                                                                                           \u001b[22;1H~             "]
